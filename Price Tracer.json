      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [
        0,
        640
      ],
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "QdOk4yScdiW9Hny3",
          "name": "Google Sheets account 4"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const scraped = $('Extract Price').first().json;\nconst sheetRows = $('Read Last Price (Sheets)').all();\n\n// Get last stored price (first row of the sheet)\nconst lastRow =\n  sheetRows.length > 0\n    ? sheetRows[sheetRows.length - 1].json\n    : null;\nconst lastPrice = lastRow ? parseFloat(lastRow.price) : null;\nconst currentPrice = parseFloat(scraped.price);\n\nconst dropped = lastPrice !== null && currentPrice < lastPrice;\n\nconst dropAmount = dropped\n  ? Number((lastPrice - currentPrice).toFixed(2))\n  : 0;\n\nconst dropPercent = dropped\n  ? Number((((lastPrice - currentPrice) / lastPrice) * 100).toFixed(1))\n  : 0;\n\nreturn [{\n  json: {\n    productName: scraped.productName,\n    url: scraped.url,\n    sheetId: scraped.sheetId,\n    telegramChatId: scraped.telegramChatId,\n    currentPrice,\n    lastPrice,\n    dropped,\n    dropAmount,\n    dropPercent,\n    scrapedAt: scraped.scrapedAt,\n    isFirstRun: lastPrice === null\n  }\n}];"
      },
