      "id": "f16ad7ea-8e79-4a3d-bb13-575aeef6a7aa",
      "name": "Fetch Product Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        0,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const html = $input.first().json.data;\nconst config = $('Config').first().json;\n\n// --- PRICE EXTRACTION ---\n// Supports Amazon India, Flipkart, and generic fallback.\n// Update the patterns below if targeting a different site.\n\nlet price = null;\nlet productName = 'Product';\n\n// Amazon India price patterns\nconst amazonPatterns = [\n  /<span class=\"a-price-whole\"[^>]*>([\\d,]+)<\\/span>/,\n  /\"priceAmount\":([\\d.]+)/,\n  /<span id=\"priceblock_ourprice\"[^>]*>[\\s\\S]*?([\\d,]+)<\\/span>/\n];\n\n// Flipkart price patterns\nconst flipkartPatterns = [\n  /<div class=\"_30jeq3 _16Jk6d\"[^>]*>.*?₹([\\d,]+)/,\n  /<div class=\"_30jeq3\"[^>]*>.*?₹([\\d,]+)/,\n  /\"selling_price\":\"([\\d,]+)\"/\n];\n\n// Generic fallback — looks for ₹ followed by numbers\nconst genericPattern = /₹\\s*([\\d,]+(?:\\.[\\d]{2})?)/;\n\n// Try Amazon\nfor (const pattern of amazonPatterns) {\n  const match = html.match(pattern);\n  if (match) {\n    price = parseFloat(match[1].replace(/,/g, ''));\n    break;\n  }\n}\n\n// Try Flipkart\nif (!price) {\n  for (const pattern of flipkartPatterns) {\n    const match = html.match(pattern);\n    if (match) {\n      price = parseFloat(match[1].replace(/,/g, ''));\n      break;\n    }\n  }\n}\n\n// Generic fallback\nif (!price) {\n  const match = html.match(genericPattern);\n  if (match) {\n    price = parseFloat(match[1].replace(/,/g, ''));\n  }\n}\n\n// Extract product title\nconst titleMatch = html.match(/<title>([^<]+)<\\/title>/) ||\n                   html.match(/id=\"productTitle\"[^>]*>\\s*([^<]+)/);\nif (titleMatch) {\n  productName = titleMatch[1].trim().substring(0, 80);\n}\n\nif (!price) {\n  throw new Error('Could not extract price from the page. Check the URL or update the CSS selectors.');\n}\n\nreturn [{\n  json: {\n    price,\n    productName,\n    url: config.PRODUCT_URL,\n    sheetId: config.SHEET_ID,\n    telegramChatId: config.TELEGRAM_CHAT_ID,\n    scrapedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "0d21db00-b766-4fa9-ab39-133747bf6abe",
